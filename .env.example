# ---- Postgres ----
POSTGRES_USER=sandcastle
POSTGRES_PASSWORD=sandcastle
POSTGRES_DB=sandcastle
POSTGRES_PORT=5432

# Used by the backend container (compose overrides host to `postgres`).
# For running the backend on the host instead, point at localhost.
DATABASE_URL=postgresql+psycopg2://sandcastle:sandcastle@localhost:5432/sandcastle

# ---- Redis / queue ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Ports ----
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- LLM ----
# Provider for the coding agent: gemini (default, free tier) or anthropic.
LLM_PROVIDER=gemini
AGENT_MODEL=gemini-2.5-flash
AGENT_MAX_STEPS=15

# Get a free key at https://aistudio.google.com/apikey
# Free-tier quota is per-minute AND per-day, and both are per-model; the agent paces itself to match.
# Raise it (or set 0 to disable pacing) on a paid tier.
GEMINI_RPM=10
GEMINI_API_KEY=

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Sandbox (Phase 5) ----
# Image the agent's code executes in: docker build -t sandcastle-sandbox:latest ./sandbox
SANDBOX_IMAGE=sandcastle-sandbox:latest
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS=256
# Hard wall-clock budget per run, in seconds. The watchdog kills the container.
SANDBOX_TIMEOUT=300

# ---- Database pool ----
# Per process. Cloud Run runs N instances of the API, the worker and beat are
# two more, and they all share one Postgres: keep instances x (size + overflow)
# under the server's max_connections. A db-f1-micro allows about 25, so the
# deployed API uses 2 + 3.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# ---- Orphaned-run sweeper ----
# A `queued` run older than this was lost by the broker (Redis is not durable).
QUEUED_STALE_AFTER_SECONDS=1800
# Added to SANDBOX_TIMEOUT to decide a `running` run has lost its worker. Covers
# clone + image pull on top of the sandbox's own budget.
RUNNING_STALE_GRACE_SECONDS=900
# How often celery beat runs the sweep.
STALE_SWEEP_INTERVAL_SECONDS=300

# ---- Observability (Langfuse) ----
# Tracing is OFF unless BOTH keys are set. Get them from a Langfuse project's
# settings. Leave them blank and the SDK is never even imported.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional. Blank means Langfuse Cloud; set either one for a self-hosted
# instance, e.g. http://localhost:3000. LANGFUSE_HOST wins if both are set.
LANGFUSE_HOST=
LANGFUSE_BASE_URL=

# ---- Misc ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
